# =====================================================================
# HS TKD Academy - OnLine — Variables de entorno
# Copia este archivo como `.env.local` y completa los valores reales.
# =====================================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HS TKD Academy - OnLine"

# Seguridad de sesión (JWT). Genera uno con: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"

# ---------------------------------------------------------------------
# Base de datos (PostgreSQL) — ver prisma/schema.prisma
# La app corre con la capa mock por defecto. Para producción, define
# DATABASE_URL y cambia DATA_DRIVER=prisma.
# ---------------------------------------------------------------------
DATA_DRIVER="mock"            # "mock" | "prisma"
DATABASE_URL="postgresql://user:password@localhost:5432/hstkd?schema=public"

# ---------------------------------------------------------------------
# Stripe (pagos) — https://dashboard.stripe.com/apikeys
# Mientras no se definan, el checkout corre en modo simulado.
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------
# Zoom (clases en vivo) — Server-to-Server OAuth App
# https://marketplace.zoom.us/  → Build App → Server-to-Server OAuth
# Mientras no se definan, las reuniones se generan en modo simulado.
# ---------------------------------------------------------------------
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_HOST_EMAIL="henry21.sigchos@gmail.com"
